{
  "name": "command-proxy",
  "version": "1.0.1",
  "description": "Run commands in a local directory on a remote server, with continuous two-way file sync.",
  "type": "module",
  "bin": {
    "command-proxy": "bin/command-proxy.js",
    "cmdp": "bin/command-proxy.js"
  },
  "files": [
    "bin",
    "scripts",
    "src"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "postinstall": "node scripts/install-mutagen.js",
    "test": "node --test"
  },
  "keywords": [
    "ssh",
    "remote",
    "mutagen",
    "sync",
    "cli",
    "command"
  ],
  "author": "yanggaoji",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanggaoji/command-proxy.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "undici": "^6.29.1"
  }
}
